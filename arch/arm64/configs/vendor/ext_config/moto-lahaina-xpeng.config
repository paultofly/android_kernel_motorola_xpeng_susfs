#
# Please avoid changing the Qualcomm defconfig files and use this file to
# add any Motorola-specific configuration changes that are applicable to
# userdebug, eng, and user builds.
#
# After building, a list of all of the config files that are used can be found
# at the top of:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/mapphone_defconfig
#
# The actual output of the kernel configuration system can be found at:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/.config
#
# You can check the .config file to verify that your configuration option is
# being set as expected.
#

CONFIG_SND_PRI_MI2S_AW882XX=y
CONFIG_SND_ENABLE_QCOM_PMIC_HAPTIC=y
CONFIG_HAPTIC_POWER_ON=y
CONFIG_AW882XX_DRIVER_V1=y
CONFIG_MULTI_CAM_FLASH_STATUS=y
CONFIG_CAMERA_VOLTAGE_COMPATIBLE=y
CONFIG_CAMERA_FLASH_PWM=y
CONFIG_AF_NOISE_ELIMINATION=y
CONFIG_MSM_TZ_QSEE_LOG=y
# CONFIG_TOUCHSCREEN_ST is not set
# CONFIG_TOUCHSCREEN_ST_I2C is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_I2C is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_CORE is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_RMI_DEV is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_FW_UPDATE is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_FW_UPDATE_EXTRA_SYSFS is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_TEST_REPORTING is not set
# CONFIG_SECURE_TOUCH_SYNAPTICS_DSX is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_SPI is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_I2C is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_CORE is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_TOUCH is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_DEVICE is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_TESTING is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_REFLASH is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_RECOVERY is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_ZEROFLASH is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_DIAGNOSTICS is not set
# CONFIG_TOUCHSCREEN_ATMEL_MXT is not set
# CONFIG_TOUCHSCREEN_FTS is not set
# CONFIG_NFC_QTI_I2C is not set
# CONFIG_USB_REDRIVER_NB7VPQ904M is not set
CONFIG_HZ_250=y
CONFIG_BLK_CGROUP=y
CONFIG_CFQ_GROUP_IOSCHED=y
CONFIG_USB_CONFIGFS_F_UVC=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_CMA_SIZE_MBYTES=20
CONFIG_CRYPTO_CHACHA20POLY1305=y

# ReSukiSU
CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KALLSYMS_ALL=y

# Re:Kernel
CONFIG_REKERNEL=y

# Kernel configurations for DroidSpaces support (ported from ravindu644 DroidSpaces GKI configs)
# IPC
# CONFIG_SYSVIPC disabled - Android FCM v7 requires CONFIG_SYSVIPC=n
CONFIG_POSIX_MQUEUE=y

# Namespaces
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# HW Access Support
CONFIG_DEVTMPFS=y

# Networking (Enhanced NAT support)
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# UFW support
# (this 5.4 tree predates the unified NETFILTER_XT_TARGET_REJECT symbol;
# use the ipv4 iptables REJECT target equivalent for UFW drop semantics)
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y

# Fail2ban support
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# Enable xattr, posix acl support on tmpfs (For NixOS support)
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# ===== 新增功能 (2026-10-02) =====

# DroidSpaces: 用户命名空间 (USER_NS); 缺失时容器无法创建 user namespace。
# 参考: paulcbfly/xpeng_kernel_susfs 26427f8 (ENABLE_DROIDSPACES sym 列表加入 USER_NS)
CONFIG_USER_NS=y

# TCP 拥塞控制: BBRv3 + TCP Brutal (编入但不默认)
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
# CONFIG_DEFAULT_BBR=y  # 2026-10-02 修复: 默认改回 cubic, 见 BUILD_LOG §10
CONFIG_DEFAULT_TCP_CONG="cubic"
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_VEGAS=y
CONFIG_TCP_CONG_NV=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_HTCP=y
CONFIG_TCP_CONG_BRUTAL=y
CONFIG_NET_SCH_FQ=y
# 注意: 参考实现最终把 fq 设为默认 qdisc, 但其修复提交 38c3f963 记录 fq 的
# per-flow pacing 与 rmnet QMAP 聚合不兼容, 会导致移动数据 有信号无网。
# 故保留 MMI 基线 pfifo_fast; BBR 仍为默认算法。需要时可:
#   sysctl -w net.core.default_qdisc=fq

# NoMount 路径重定向子系统 (maxsteeel/nomount)
CONFIG_NOMOUNT=y

# 华为 LZ4K/LZ4KD 压缩算法 (lib/lz4k)
CONFIG_LZ4K=y

