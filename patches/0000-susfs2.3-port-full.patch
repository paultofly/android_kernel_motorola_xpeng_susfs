--- /dev/null
+++ b/fs/susfs.c
@@ -0,0 +1,1538 @@
+#include <linux/version.h>
+#include <linux/cred.h>
+#include <linux/fs.h>
+#include <linux/slab.h>
+#include <linux/seq_file.h>
